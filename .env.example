# ─────────────────────────────────────────────────────────────────────────────
# Gulf Oil Desk — Environment Variables
# Copy this file to .env.local and fill in the values you need.
# The app runs without any keys (uses mock/fallback data for all providers).
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Assistant (required for live AI responses) ────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use (default: claude-haiku-4-5-20251001 for fast, affordable responses)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Max tokens per response (default: 1500)
ANTHROPIC_MAX_TOKENS=1500

# Response latency budget in milliseconds (default: 6000)
ASSISTANT_TIMEOUT_MS=6000

# Rate limit: requests per minute per IP (default: 10)
ASSISTANT_RATE_LIMIT=10

# ── Economic Calendar ────────────────────────────────────────────────────────
# Trading Economics API (https://tradingeconomics.com/api/) — free tier available
# Without this key, the app uses realistic mock calendar data.
TRADING_ECONOMICS_API_KEY=

# Finnhub.io — alternative free calendar (https://finnhub.io/)
FINNHUB_API_KEY=

# ── EIA Oil Data ─────────────────────────────────────────────────────────────
# US Energy Information Administration — free API key
# Register at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── Twitter / X API (optional) ───────────────────────────────────────────────
# Required for live @zerohedge, @watcherguru, @WalterBloomberg tweet streams.
# Without this, the Twitter source is silently disabled.
# Create a project at https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# Comma-separated list of account handles to monitor (override defaults)
TWITTER_ACCOUNTS=zerohedge,watcherguru,WalterBloomberg

# Individual account overrides (useful if handles change)
TWITTER_ACCOUNT_ZEROHEDGE=zerohedge
TWITTER_ACCOUNT_WATCHER_GURU=watcherguru
TWITTER_ACCOUNT_BLOOMBERG=WalterBloomberg

# ── Per-source enable/disable flags ──────────────────────────────────────────
# Set to "false" to disable a source (useful to skip paywalled sources)
NEWS_YAHOO=true
NEWS_WSJ=true
NEWS_FT=true
NEWS_REUTERS=true
NEWS_CNBC=true
NEWS_MARKETWATCH=true
NEWS_OILPRICE=true
NEWS_TWITTER=true

# ── Deployment ───────────────────────────────────────────────────────────────
# Automatically set by Vercel; needed for absolute internal API URLs
# VERCEL_URL=your-deployment.vercel.app
